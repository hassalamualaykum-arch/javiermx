# Datos sensibles y locales — NO subir y NO borrar en el deploy
config.php
*.sql

# Imágenes subidas desde el panel: la carpeta se mantiene, su contenido se conserva
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# Ejemplos PWA: se suben a mano (SSH / Administrador de archivos), el deploy no los toca
/pwa/
